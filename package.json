{
  "name": "mobile-dope-api",
  "version": "1.0.0",
  "private": true,
  "description": "RESTful API for Mobile DOPE precision shooting application",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:prod": "NODE_ENV=production node dist/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "markdownlint": "markdownlint-cli2 \"**/*.md\"",
    "markdownlint:fix": "markdownlint-cli2 --fix \"**/*.md\"",
    "dupes": "jscpd",
    "links": "lychee --no-progress \"**/*.md\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.eslint.json",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "security:osv": "osv-scanner --lockfile=package-lock.json",
    "security:semgrep": "semgrep --config=p/typescript --config=p/javascript --config=p/nodejsscan --config=p/express --config=p/owasp-top-ten --config=p/secrets --error --metrics=off",
    "security:secrets": "gitleaks detect --no-banner",
    "license:check": "license-checker-rseidelsohn --production --onlyAllow 'MIT;ISC;Apache-2.0;BSD-2-Clause;BSD-3-Clause;0BSD;CC0-1.0;Unlicense;Python-2.0;WTFPL;BlueOak-1.0.0;CC-BY-4.0;CC-BY-3.0;Unicode-DFS-2016;Unicode-3.0' --excludePrivatePackages --summary",
    "check": "npm-run-all -p lint typecheck markdownlint dupes",
    "check:all": "npm-run-all -s check format:check test",
    "prepare": "husky",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "seed": "sequelize-cli db:seed:all",
    "docker:up": "docker-compose up",
    "docker:down": "docker-compose down",
    "docker:build": "docker-compose build",
    "docker:logs": "docker-compose logs -f api"
  },
  "keywords": [
    "api",
    "rest",
    "express",
    "typescript",
    "ballistics",
    "dope",
    "shooting"
  ],
  "author": "Mobile DOPE Development Team",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bunyan": "^1.8.15",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^17.4.1",
    "express": "^4.18.2",
    "express-jwt": "^8.4.1",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^8.1.0",
    "i18n": "^0.15.1",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.6.5",
    "node-cache": "^5.1.2",
    "sequelize": "^6.35.2",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.0.2",
    "@commitlint/config-conventional": "21.0.2",
    "@eslint/js": "9.39.4",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/bcrypt": "^5.0.2",
    "@types/bunyan": "^1.8.11",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/lodash": "^4.14.202",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.19.17",
    "@types/semver": "7.8.0",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import-x": "4.16.2",
    "eslint-plugin-jsdoc": "63.0.2",
    "eslint-plugin-n": "18.1.0",
    "eslint-plugin-no-secrets": "2.3.3",
    "eslint-plugin-prettier": "^5.1.2",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-security": "4.0.0",
    "eslint-plugin-sonarjs": "4.0.3",
    "eslint-plugin-unicorn": "65.0.1",
    "globals": "17.6.0",
    "husky": "9.1.7",
    "jest": "^29.7.0",
    "jscpd": "5.0.6",
    "license-checker-rseidelsohn": "5.0.1",
    "lint-staged": "17.0.7",
    "markdownlint-cli2": "0.22.1",
    "nodemon": "^3.0.2",
    "npm-run-all2": "9.0.1",
    "prettier": "^3.1.1",
    "semver": "7.8.5",
    "sequelize-cli": "^6.6.2",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsc-files": "1.1.4",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.61.0"
  },
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=10.0.0"
  }
}
