{
  "config": {
    "default": true,
    "MD003": { "style": "atx" },
    "MD004": { "style": "dash" },
    "MD007": { "indent": 2 },
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD025": true,
    "MD029": { "style": "ordered" },
    "MD033": { "allowed_elements": ["br", "details", "summary", "kbd", "sub", "sup"] },
    "MD040": true,
    "MD041": true,
    "MD046": { "style": "fenced" },
    "MD048": { "style": "backtick" },
    "MD049": { "style": "asterisk" },
    "MD050": { "style": "asterisk" },
    // MD060 (table-column-style) is newer than this config's source and overly
    // pedantic about table pipe spacing; disabled to avoid reformatting tables.
    "MD060": false
  },
  "ignores": [
    "node_modules/",
    "dist/",
    "build/",
    "coverage/",
    "reports/",
    "CHANGELOG.md",
    ".github/PULL_REQUEST_TEMPLATE.md",
    // standards/ is imported reference documentation with pre-existing structure
    // (TOCs, callouts) that predates these lint rules; not actively maintained here.
    "standards/"
  ]
}
